# Active Broker: ANGEL or ZERODHA
BROKER=ANGEL

# Angel One API Credentials
API_KEY=your_api_key_here
CLIENT_ID=your_client_id_here
PASSWORD=your_password_here
TOTP_SECRET=your_totp_secret_here

# Zerodha Kite Credentials
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_USER_ID=your_kite_user_id_here
KITE_PASSWORD=your_kite_password_here
KITE_TOTP_SECRET=your_kite_totp_secret_here
KITE_ACCESS_TOKEN=your_kite_access_token_here

# MongoDB Settings
# - For Local/Host run: mongodb://localhost:27017/
# - For Docker/Compose run: mongodb://mongodb:27017/
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=nifty_bot
MONGO_COLLECTION=trades

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# System Settings
LIVE_TRADE_ENABLED=FALSE
TRADE_FULL_DAY=FALSE
PROCESS_TYPE=BACKEND
STATIC_IP=10.0.0.149

# Frontend Settings
# - Set to http://<YOUR_CLOUD_IP>:8000 when deploying to a remote cloud VPS
NEXT_PUBLIC_API_URL=http://localhost:8000
TRADE_FULL_DAY=TRUE

# Profit Protection Configuration
PROFIT_PROTECTION_ENABLED=TRUE
PROFIT_PROTECTION_THRESHOLD=1000.0
PROFIT_PROTECTION_DRAWDOWN_PCT=0.50

